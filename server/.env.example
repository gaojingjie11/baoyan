# 外部 Postgres（你的腾讯云 PG）
DATABASE_URL=postgres://admin:sdl%40admin@42.193.104.173:5432/baoyan?sslmode=disable

# 允许的前端源（同源部署用不到；跨域才需要，逗号分隔可多个）
CORS_ORIGIN=https://baoyan-one.vercel.app

# JWT 签名密钥：生产务必设置固定值（否则每次重启旧 token 失效）。
# setup.sh 首次部署会自动生成随机值写入 .env。
JWT_SECRET=

# 密码加盐（可选，留空也可；设置后不可更改，否则旧密码无法校验）
PASSWORD_PEPPER=
