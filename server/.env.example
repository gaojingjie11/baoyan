# Copy this file to /etc/baoyan/baoyan.env on the server and replace every
# placeholder there. Do not put real values in this repository.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=disable
JWT_SECRET=replace-with-a-random-32-byte-or-longer-secret
# Optional extra password secret. Leave empty to avoid another deployment value.
PASSWORD_PEPPER=
BOOTSTRAP_USERNAME=replace-on-first-deploy-only
BOOTSTRAP_PASSWORD=replace-on-first-deploy-only
