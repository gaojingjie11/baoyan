# 部署环境模板（docker compose 通过 --env-file 读取此文件）
# 本文件已内置数据库与种子用户凭据，无需手动填写；JWT_SECRET 由 setup.sh 自动生成。

# 外部 Postgres（密码中的 @ 已转义为 %40）
DATABASE_URL=postgres://admin:sdl%40admin@42.193.104.173:5432/baoyan?sslmode=disable

# JWT 签名密钥（32+ 字节）。setup.sh 首次部署会自动替换为随机值，无需手动填。
JWT_SECRET=__AUTO_GENERATE__

# 可选：额外的密码 salt，留空即可。
PASSWORD_PEPPER=

# 首次启动时自动创建的种子用户（仅当数据库里还没有该用户名时）。
# 已按你的要求设为 gao / gao040907。
BOOTSTRAP_USERNAME=gao
BOOTSTRAP_PASSWORD=gao040907
