# 后端 HTTPS 反代配置（Nginx）
# 用法：
#   1) apt install nginx certbot python3-certbot-nginx
#   2) 把下面 server 块放进 /etc/nginx/conf.d/baoyan-api.conf（把域名改成你的）
#   3) sudo nginx -t && sudo systemctl reload nginx
#   4) sudo certbot --nginx -d baoyan-api.yourdomain.com   # 自动申请并写入证书、跳转 HTTPS
#
# 证书续期是自动的（certbot 装了 systemd timer）。后端容器映射宿主机 2026，
# Nginx 在宿主机上反代到 localhost:2026。

server {
    listen 80;
    server_name baoyan-api.yourdomain.com;

    # 让 certbot 的 HTTP-01 校验能通过（申请证书时需要，之后可保留）
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # 其余 80 端口先不强制跳转，等证书下来后 certbot 会自动加上 443 + 跳转
    location / {
        return 404;
    }
}

server {
    listen 443 ssl;
    server_name baoyan-api.yourdomain.com;

    # certbot 申请成功后会自动填充下面两行（也可手动指定路径）：
    # ssl_certificate     /etc/letsencrypt/live/baoyan-api.yourdomain.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/baoyan-api.yourdomain.com/privkey.pem;
    # include             /etc/letsencrypt/options-ssl-nginx.conf;
    # ssl_dhparam         /etc/letsencrypt/ssl-dhparams.pem;

    # 可选：加一层 Basic Auth，避免任何人都能写你的进度
    # sudo htpasswd -c /etc/nginx/baoyan.htpasswd baoyan
    # auth_basic "baoyan api";
    # auth_basic_user_file /etc/nginx/baoyan.htpasswd;

    location / {
        proxy_pass http://localhost:2026;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
