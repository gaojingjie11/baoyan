# Caddy 反向代理示例：自动申请 Let's Encrypt 证书
# 用法：把下面内容写进 /etc/caddy/Caddyfile，然后 `caddy reload`
# 前置：服务器有公网 IP，域名 baoyan-api.yourdomain.com 已 A 记录指向本机

baoyan-api.yourdomain.com {
    # 可选：加一层 Basic Auth，避免任何人都能写你的进度
    # basicauth {
    #     baoyan $2a$14$xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
    # }
    reverse_proxy localhost:2026
}
